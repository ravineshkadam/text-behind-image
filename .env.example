# Supabase Configuration
# Copy this file to .env.local and fill in your Supabase project details

# Your Supabase project URL (found in your Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Your Supabase anon key (found in your Supabase dashboard under Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: Supabase service role key (only needed for server-side operations)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Stripe Configuration (Optional - only needed for payments)
# Your Stripe secret key (found in your Stripe dashboard under Developers > API keys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Your Stripe webhook endpoint secret (for handling webhook events)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret